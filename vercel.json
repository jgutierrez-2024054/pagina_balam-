{
  "buildCommand": "npm run postinstall",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/[...catchall]"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/api/[...catchall]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
