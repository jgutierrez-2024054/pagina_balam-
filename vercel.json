{
  "buildCommand": "npm run postinstall",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/server/index.js"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/server/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
